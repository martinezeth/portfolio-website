---
/**
 * Carousel: one image per slide, always fully visible on the project's
 * color field. Native scroll-snap does the sliding (swipe works on touch,
 * no JS needed to view); the script drives the counter and arrow buttons.
 */
interface Image { src: string; alt: string; kind: 'phone' | 'wide' | 'contain' }
interface Props {
  images: Image[];
  /** Deep color behind the slides. */
  panel?: string;
  /** Larger sizes for the project page. */
  size?: 'panel' | 'page';
}
const { images, panel = 'var(--surface)', size = 'panel' } = Astro.props;
const tall = images.some((i) => i.kind === 'phone');
// Consecutive phone screenshots share a slide in pairs; wide images stand alone.
const slides: Image[][] = [];
for (const img of images) {
  const last = slides[slides.length - 1];
  if (img.kind === 'phone' && last && last.length === 1 && last[0].kind === 'phone') last.push(img);
  else slides.push([img]);
}
---
<div class:list={['gallery', `gallery-${size}`, { tall }]} data-gallery>
  <div class="frame" style={`background:${panel}`}>
    <div class="track" data-track tabindex="0" aria-label="Project images">
      {slides.map((group, i) => (
        <div class="slide" aria-label={`${i + 1} of ${slides.length}`}>
          {group.map((img) =>
            img.kind === 'phone' ? (
              <div class="phone"><img src={img.src} alt={img.alt} loading="lazy" /></div>
            ) : (
              <img class="wide" src={img.src} alt={img.alt} loading="lazy" />
            ),
          )}
        </div>
      ))}
      <slot />
    </div>
  </div>
  {slides.length > 1 && (
    <div class="controls">
      <span class="m count"><span data-index aria-live="polite">1</span> / {slides.length}</span>
      <div class="arrows">
        <button type="button" class="arrow" data-prev aria-label="Previous image">←</button>
        <button type="button" class="arrow" data-next aria-label="Next image">→</button>
      </div>
    </div>
  )}
</div>

<style>
  .gallery { min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .frame { overflow: hidden; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1); }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--volt); outline-offset: -2px; }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 20px 14px;
  }
  .tall .slide { height: 370px; }
  .wide { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; }
  .phone {
    width: 150px;
    height: 325px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #000;
    overflow: hidden;
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.7);
  }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; }

  @media (min-width: 56rem) {
    .slide { height: 420px; gap: 24px; padding: 20px; }
    .tall .slide { height: 560px; }
    .phone { width: 236px; height: 510px; border-radius: 30px; }
    .gallery-page .slide { height: 560px; }
    .gallery-page.tall .slide { height: 660px; }
    .gallery-page .phone { width: 280px; height: 606px; border-radius: 34px; }
  }

  .controls { display: flex; align-items: center; justify-content: space-between; padding-inline: 4px; }
  .count { font-size: 12px; color: var(--slate); }
  .arrows { display: flex; gap: 8px; }
  .arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--text);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s;
  }
  .arrow:hover { border-color: var(--text); }
  .arrow[disabled] { opacity: 0.35; cursor: default; }
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const index = gallery.querySelector<HTMLElement>('[data-index]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !index || !prev || !next) continue;
    const n = track.children.length;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const update = () => {
      const i = current();
      index.textContent = String(i + 1);
      prev.disabled = i <= 0;
      next.disabled = i >= n - 1;
    };
    const go = (i: number) => {
      const target = Math.max(0, Math.min(n - 1, i));
      track.scrollTo({ left: target * track.clientWidth, behavior: 'smooth' });
    };
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => { go(current()); update(); });
    update();
  }
</script>
