---
/**
 * Project page. Only projects with `caseStudy: true` get one.
 * Layout: title + facts card, full-width gallery, then the Markdown body
 * rendered as label-column sections (each `##` heading starts a section).
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.caseStudy);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const accent = d.accent ?? 'var(--volt)';
const panel = d.panel ?? '#27292D';
---
<Base title={`${d.title} · Ethan Martinez`} description={d.summary}>
  <Nav base="/" />
  <main id="main" class="wrap">
    <header class="head">
      <div class="title">
        <a class="m navlink back" href="/#work">← All work</a>
        <div class="meta m">
          {d.year && <span>{d.year}</span>}
          {d.status && <span style={`color:${accent}`}>{d.status}</span>}
        </div>
        <h1 class="f">{d.title}</h1>
        <p class="lede">{d.summary}</p>
      </div>
      <dl class="facts">
        {d.tech.length > 0 && (
          <div><dt class="lbl">Built with</dt><dd class="tags">{d.tech.map((t) => <span class="tag">{t}</span>)}</dd></div>
        )}
        {d.links.length > 0 && (
          <div><dt class="lbl">Links</dt><dd>{d.links.map((l) => <a class="u" href={l.href} rel="noopener">{l.label} ↗</a>)}</dd></div>
        )}
      </dl>
    </header>

    {d.gallery.length > 0 && (
      <div class="hero-gallery" style={`background:linear-gradient(135deg, ${panel}cc 0%, var(--surface) 70%)`}>
        <Gallery images={d.gallery} panel={panel} size="page" />
      </div>
    )}

    <article class="prose" style={`--accent:${accent}`}>
      <Content />
    </article>

    <div class="next">
      <a class="card" href="/#work"><span class="lbl">← Back</span><span class="f">All work</span></a>
    </div>
  </main>
  <Footer topHref="/#work" topLabel="All work ↑" />
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 24px; padding: 40px 0 28px; }
  .title { display: flex; flex-direction: column; gap: 18px; }
  .back { font-size: 13px; align-self: flex-start; }
  .meta { display: flex; gap: 16px; font-size: 12px; color: var(--slate); }
  h1 { font-size: 56px; line-height: 0.95; letter-spacing: -0.035em; }
  .lede { margin: 0; font-size: 19px; line-height: 1.4; color: var(--text-2); max-width: 640px; }
  .facts {
    margin: 0;
    padding: 20px 22px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 15px;
  }
  .facts div { display: flex; flex-direction: column; gap: 6px; }
  .facts dd { margin: 0; color: var(--text-2); display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .hero-gallery { padding: 24px 20px; border-radius: 22px; border: 1px solid var(--line); }
  .prose { max-width: 680px; padding-top: 40px; font-size: 17px; line-height: 1.65; color: var(--text-2); }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text);
    margin: 48px 0 16px;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(blockquote) {
    margin: 24px 0;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 26px;
    line-height: 1.3;
    color: var(--text);
  }
  .prose :global(img) { border-radius: 12px; margin: 8px 0 24px; }
  .prose :global(a) { font-weight: 500; text-decoration: underline; text-decoration-color: var(--volt); text-underline-offset: 0.2em; }
  .next { margin-top: 64px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 0.24s var(--ease), border-color 0.24s;
  }
  .card:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, 0.22); }
  .card .f { font-size: 28px; letter-spacing: -0.02em; }

  @media (min-width: 56rem) {
    .head { display: grid; grid-template-columns: 1fr 340px; gap: 56px; align-items: end; padding: 64px 0 40px; }
    h1 { font-size: 96px; }
    .lede { font-size: 24px; }
    .facts { padding: 24px 26px; }
    .hero-gallery { padding: 40px 40px 32px; border-radius: 28px; }
    .prose { padding-top: 56px; font-size: 19px; }
    .prose :global(h2) { font-size: 30px; margin-top: 56px; }
    .next { margin-top: 96px; }
  }
</style>
