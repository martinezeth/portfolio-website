---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Not found · Ethan Martinez" description="That page does not exist.">
  <Nav base="/" />
  <main id="main" class="wrap nf">
    <span class="lbl">404</span>
    <h1 class="f">Nothing here.</h1>
    <p>That page does not exist, or it moved. The work is all on the home page.</p>
    <a class="btn btn-fill" href="/">Back home</a>
  </main>
  <Footer topHref="/" topLabel="Home ↑" />
</Base>

<style>
  .nf { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding: 80px 0 120px; min-height: 60vh; }
  h1 { font-size: clamp(48px, 10vw, 96px); letter-spacing: -0.035em; line-height: 0.95; }
  p { margin: 0; color: var(--text-2); max-width: 480px; }
</style>
