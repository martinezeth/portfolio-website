---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../site';

// TODO(ethan): the two About paragraphs below are a draft. Rewrite in your own words.
const all = await getCollection('projects');
const byOrder = (a: (typeof all)[number], b: (typeof all)[number]) => a.data.order - b.data.order;
const featured = all.filter((p) => p.data.featured).sort(byOrder);
const more = all.filter((p) => !p.data.featured).sort(byOrder);

const skills = [
  { k: 'ML & Data', v: ['Python · OpenCV', 'CNNs · scikit-learn', 'NumPy · Matplotlib'] },
  { k: 'Backend & AI', v: ['Amazon Bedrock', 'DynamoDB · Cognito', 'Supabase · Postgres'] },
  { k: 'Web & Apps', v: ['TypeScript · React', 'Kotlin Multiplatform', 'SwiftUI · Unreal Engine'] },
];
---
<Base title={`${site.name} · ${site.title}`}>
  <Nav />
  <main id="main" class="wrap">
    <header id="top" class="hero">
      <div class="hero-text">
        <span class="lbl">{site.location}</span>
        <h1 class="f">
          {site.name}
          <span class="fi role">{site.title}</span>
        </h1>
      </div>
      <div class="hero-row">
        <div class="actions">
          <a class="btn btn-fill" href="#work">See the work <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="#contact">Get in touch</a>
          <div class="social m">
            <a class="navlink" href={site.github} rel="noopener">GitHub ↗</a>
            <a class="navlink" href={site.linkedin} rel="noopener">LinkedIn ↗</a>
            {site.substack && <a class="navlink" href={site.substack} rel="noopener">Substack ↗</a>}
          </div>
        </div>
        <span class="lbl range">{site.range.join(' · ')}</span>
      </div>
    </header>

    <section id="work" class="section work">
      <h2 class="f h2">Selected Work</h2>
      <div class="panels">
        {featured.map((p, i) => <ProjectPanel project={p} index={i} />)}
      </div>
    </section>

    {more.length > 0 && (
      <section class="section more">
        <h2 class="f h2 small">More Work</h2>
        <div class="cards">
          {more.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    )}

    <section id="experience" class="section experience">
      <h2 class="f h2">Experience</h2>
      <Timeline />
    </section>

    <section id="about" class="section about">
      <h2 class="f h2">About</h2>
      <div class="about-body">
        <p class="lede">I like owning a problem across its layers: the data, the model or service behind it, and the interface people actually use. Most of my work has been exactly that, from scoping with the people who need it to shipping it.</p>
        <div class="skills">
          {skills.map((s) => (
            <div>
              <div class="lbl">{s.k}</div>
              <div class="skill-list">{s.v.map((line) => <span>{line}</span>)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-text">
        <h2 class="f">Get in Touch.</h2>
        <p>Open to full-time roles and interesting problems. Email is the fastest way to reach me.</p>
        <div class="email-row">
          <a class="m u email" href={`mailto:${site.email}`}>{site.email}</a>
          <button type="button" class="btn btn-ghost copy" data-copy={site.email}>Copy</button>
        </div>
      </div>
      <div class="contact-links">
        <a class="btn btn-ghost" href={site.linkedin} rel="noopener">LinkedIn ↗</a>
        <a class="btn btn-ghost" href={site.github} rel="noopener">GitHub ↗</a>
        {site.substack && <a class="btn btn-ghost" href={site.substack} rel="noopener">Substack ↗</a>}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn) {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copy ?? '';
      try { await navigator.clipboard.writeText(email); } catch {}
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  /* Hero: full-width type, no image. */
  .hero { display: flex; flex-direction: column; gap: 22px; padding: 28px 0 22px; }
  .hero-text { display: flex; flex-direction: column; gap: 18px; }
  h1 {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 56px;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .role { color: var(--volt); font-size: 38px; font-weight: 400; letter-spacing: -0.02em; line-height: 1; }
  .hero-row { display: flex; flex-direction: column; gap: 18px; }
  .actions { display: flex; flex-direction: column; gap: 10px; }
  .arrow { font-size: 18px; line-height: 0; }
  .social { display: flex; gap: 18px; font-size: 13px; }
  .range { letter-spacing: 0.1em; line-height: 1.8; }

  @media (min-width: 56rem) {
    .hero { gap: 40px; padding: 64px 0 40px; }
    h1 { font-size: clamp(88px, 11.5vw, 152px); gap: 14px; line-height: 0.9; letter-spacing: -0.045em; }
    .role { font-size: clamp(48px, 5.6vw, 72px); }
    .hero-row { flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .actions { flex-direction: row; align-items: center; gap: 14px; flex-wrap: wrap; }
    .social { margin-left: 8px; }
  }

  /* Sections */
  .section { display: flex; flex-direction: column; gap: 18px; }
  .work { padding-top: 32px; }
  .more { padding-top: 56px; gap: 16px; }
  .experience, .about { padding-top: 64px; gap: 20px; }
  .h2 { font-size: 36px; letter-spacing: -0.03em; line-height: 1; }
  .h2.small { font-size: 26px; letter-spacing: -0.02em; }
  .panels { display: flex; flex-direction: column; gap: 18px; }
  .cards { display: flex; flex-direction: column; gap: 16px; }
  .about-body { display: flex; flex-direction: column; gap: 20px; }
  .about p { margin: 0; color: var(--text-2); }
  .lede { font-size: 17px; }
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; margin-top: 4px; }
  .skills .lbl { margin-bottom: 8px; }
  .skill-list { display: flex; flex-direction: column; font-size: 14px; color: var(--text-2); line-height: 1.7; }

  @media (min-width: 56rem) {
    .section { gap: 28px; }
    .work { padding-top: 40px; }
    .more { padding-top: 72px; gap: 24px; }
    .experience, .about { padding-top: 96px; display: grid; grid-template-columns: 300px 1fr; gap: 48px; align-items: start; }
    .h2 { font-size: 48px; }
    .h2.small { font-size: 30px; }
    .panels { gap: 28px; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .about-body { gap: 24px; }
    .lede { font-size: 19px; }
    .skills { grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 8px; }
    .skills .lbl { margin-bottom: 10px; }
    .skill-list { font-size: 15px; line-height: 1.8; }
  }

  /* Contact */
  .contact {
    margin-top: 72px;
    padding: 32px 24px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: radial-gradient(360px 220px at 90% 100%, rgba(157, 140, 255, 0.16), transparent 70%), var(--surface);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact h2 { font-size: 44px; letter-spacing: -0.03em; line-height: 1; }
  .contact p { margin: 0; color: var(--text-2); max-width: 520px; }
  .contact-text { display: flex; flex-direction: column; gap: 18px; }
  .email-row { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .email { font-size: 17px; }
  .copy { padding: 8px 14px; font-size: 14px; }
  .contact-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .contact-links .btn { flex: 1; }
  @media (min-width: 56rem) {
    .contact {
      margin-top: 112px;
      padding: 56px;
      border-radius: 28px;
      background: radial-gradient(640px 320px at 90% 100%, rgba(157, 140, 255, 0.16), transparent 70%), var(--surface);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 40px;
      align-items: end;
    }
    .contact h2 { font-size: 60px; }
    .contact p { font-size: 18px; }
    .contact-text { gap: 20px; }
    .email-row { flex-direction: row; align-items: center; gap: 14px; flex-wrap: wrap; }
    .email { font-size: 22px; }
    .contact-links { gap: 12px; }
    .contact-links .btn { flex: initial; }
  }
</style>
